# === Billing ===
# UPI ID for receiving payments (format: phone@bank or username@upi)
UPI_ID=9772883504@ybl

# === Server ===
PORT=3000
BASE_URL=http://localhost:3000
# Set to https://dukanreviews.com in production

# === Authentication ===
# Google OAuth (optional - for Google sign-in)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# === Email (optional) ===
# For sending password reset emails (uses console.log if not set)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# === AI Reviews (optional) ===
# OpenRouter API key for AI-generated review suggestions
OPENROUTER_API_KEY=your_openrouter_api_key

# === Database ===
DB_PATH=/data/data.db

# === Production ===
# Set to "1" if behind a proxy that sets X-Forwarded-For
TRUST_PROXY=0
